{% extends 'base.html.twig' %}

{% block title %}Mi Perfil Mágico{% endblock %}

{% block body %}
    <section class="disney-profile">
        <div class="profile-card-disney">
            <h2 class="profile-name-disney">¡Hola, {{ user.username }}!</h2>

            <div class="profile-info-disney">
                <p>✉️ <strong>Email:</strong> {{ user.email }}</p>
                <p>🎖️ <strong>Rol:</strong> {{ user.roles[0]|default('Usuario Mágico') }}</p>
            </div>

            <a href="{{ path('app_home') }}" class="btn-back-disney">🏰 Volver al Castillo</a>
        </div>
    </section>
{% endblock %}
