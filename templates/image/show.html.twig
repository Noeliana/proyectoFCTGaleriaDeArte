{% extends 'base.html.twig' %}

{% block title %}{{ image.title }}{% endblock %}

{% block body %}
    <section class="image-detail">
        <div class="content-wrapper">
            <div class="image-left">
                <img src="{{ asset('images/obras/' ~ image.imageFile) }}" alt="{{ image.title }}" class="big-image" />

                {% set likedImages = app.session.get('liked_images', []) %}
                {% set isLiked = image.id in likedImages %}

                <form method="post" action="{{ path('app_image_like', {
                    'id': image.id,
                    'from': from,
                    'slug': slug
                }) }}">
                <button class="like-btn">
                        {{ isLiked ? '❤️' : '🤍' }} {{ image.likes }}
                    </button>
                </form>
                <a href="{{ asset('images/obras/' ~ image.imageFile) }}" download class="download-btn">⬇ Descargar</a>
            </div>

            <div class="info-right">
                <h2>{{ image.title }}</h2>
                <p><strong>Descripción:</strong> {{ image.description }}</p>
                <p><strong>Creado el:</strong> {{ image.createdAt|date('Y-m-d H:i') }}</p>
                <p><strong>Destacado:</strong> {{ image.isFeatured ? 'Sí' : 'No' }}</p>

                <p><strong>Etiquetas:</strong>
                    {% for tag in image.tags %}
                        <a href="{{ path('app_tag_show', {'slug': tag.slug}) }}">{{ tag.name }}</a>{{ not loop.last ? ', ' }}
                    {% else %}
                        <span>Sin etiquetas</span>
                    {% endfor %}
                </p>

            </div>
        </div>
        <div class="return-container">
            {% if from == 'artist' and artist is defined %}
                <a href="{{ path('app_artista_show', {'id': artist.id}) }}" class="return-btn">← Volver al artista</a>
            {% elseif from == 'category' and slug is not empty %}
                <a href="{{ path('app_categoria_show', {'slug': slug}) }}" class="return-btn">← Volver a la categoría</a>
            {% elseif from == 'subcategoria' and slug is not empty %}
                <a href="{{ path('app_subcategoria_show', {'id': slug}) }}" class="return-btn">← Volver a la subcategoría</a>
            {% else %}
                <a href="{{ path('app_home') }}" class="return-btn">← Volver al inicio</a>
            {% endif %}
        </div>
    </section>
{% endblock %}
