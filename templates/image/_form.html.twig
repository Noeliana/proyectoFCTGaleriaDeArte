{{ form_start(form, {'attr': {'class': 'form-magico'}}) }}
<div class="form-row">
    <div class="campo-formulario">
        <label>{{ form_label(form.title) }}</label>
        <div class="input-con-icono">
            <span class="icono">🎨</span>
            {{ form_widget(form.title) }}
        </div>
    </div>

    <div class="campo-formulario">
        <label>{{ form_label(form.description) }}</label>
        <div class="input-con-icono">
            <span class="icono">📝</span>
            {{ form_widget(form.description) }}
        </div>
    </div>
</div>

<div class="form-row">
    <div class="campo-formulario">
        <label>{{ form_label(form.imageFile) }}</label>
        <div class="input-con-icono">
            <span class="icono">📁</span>
            {{ form_widget(form.imageFile) }}
        </div>
    </div>

    <div class="campo-formulario">
        <label>{{ form_label(form.category) }}</label>
        <div class="input-con-icono">
            <span class="icono">📂</span>
            {{ form_widget(form.category) }}
        </div>
    </div>
</div>

<div class="form-row">
    {% if form.artist is defined %}
        <div class="campo-formulario">
            <label>{{ form_label(form.artist) }}</label>
            <div class="input-con-icono">
                <span class="icono">🎭</span>
                {{ form_widget(form.artist) }}
            </div>
        </div>
    {% endif %}

    {% if form.tags is defined %}
        <div class="campo-formulario">
            <label>{{ form_label(form.tags) }}</label>
            <div class="input-con-icono">
                <span class="icono">🏷️</span>
                {{ form_widget(form.tags) }}
            </div>
        </div>
    {% endif %}
</div>
<div class="form-row solo-boton">
    <button class="btn">{{ button_label|default('Guardar') }}</button>
</div>
{{ form_end(form) }}