{% extends 'base.html.twig' %}

{% block title %}Edit Image{% endblock %}

{% block body %}
    <h1>Edit Image</h1>

    {{ include('image/_form.html.twig', {
        form: form,
        button_label: 'Update',
        image: image
    }) }}

    <div class="return-container">
        {% if from == 'subcategoria' and subcategoria is defined %}
            <a href="{{ path('app_subcategoria_show', {'id': subcategoria.id}) }}" class="return-btn">← Volver a {{ subcategoria.name }}</a>
        {% else %}
            <a href="{{ path('app_categoria_show', {'slug': category.slug}) }}" class="return-btn">← Volver a {{ category.name }}</a>
        {% endif %}
    </div>


{% endblock %}
