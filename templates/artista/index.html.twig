{% extends 'base.html.twig' %}

{% block title %}Artistas - Galería{% endblock %}

{% block body %}
    <section class="artistas">
        <h2>Artistas Oficiales</h2>

        {% if artists is empty %}
            <p>No hay artistas registrados todavía.</p>
        {% else %}
            <div class="grid-artistas">
                {% for artist in artists %}
                    <div class="artist-card">
                        <a href="{{ path('app_artista_show', {'id': artist.id}) }}">
                            <div class="circle-img">
                                <img src="{{ asset('images/artists/' ~ artist.id ~ '.jpeg') }}" alt="{{ artist.name }}">
                            </div>
                            <p>{{ artist.name }}</p>
                        </a>
                    </div>
                {% endfor %}
            </div>
        {% endif %}

        <h2>Artistas de la Comunidad</h2>

        {% if user_artists is empty %}
            <p>No hay usuarios creadores todavía.</p>
        {% else %}
            <div class="grid-artistas">
                {% for user in user_artists %}
                    <div class="artist-card">
                        <a href="{{ path('app_user_show', {'id': user.id}) }}">
                            <div class="circle-img">
                                <img src="{{ asset('images/profile-default.png') }}" alt="{{ user.username }}">
                            </div>
                            <p>{{ user.username }}</p>
                        </a>
                    </div>
                {% endfor %}
            </div>
        {% endif %}
    </section>
{% endblock %}
