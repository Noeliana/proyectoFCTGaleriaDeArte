{% extends 'base.html.twig' %}

{% block title %}Imágenes con etiqueta "{{ tag.name }}"{% endblock %}

{% block body %}
    <div class="tags">
    <h2>Imagenes etiquetadas como "{{ tag.name }}"</h2>

    {% if images is empty %}
        <p>No hay imágenes asociadas a esta etiqueta.</p>
    {% else %}
        <div class="galeria-imagenes">
            {% for image in images %}
                <div class="imagen-item">
                    <a href="{{ path('app_image_show', {'id': image.id}) ~ '?from=tag&slug=' ~ tag.slug }}">
                        <img src="{{ asset('images/obras/' ~ image.imageFile) }}" alt="{{ image.title }}">
                    </a>
                    <p>{{ image.title }}</p>
                </div>
            {% endfor %}
        </div>
    {% endif %}
    </div>
{% endblock %}
