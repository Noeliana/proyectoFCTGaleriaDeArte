{% extends 'base.html.twig' %}

{% block title %}Editar {{ artist.name }}{% endblock %}

{% block body %}
    <section class="edit-artist-section">
        <div class="form-container">
            <h1>Editar Artista</h1>

            {{ form_start(form, {
                'attr': {
                    'enctype': 'multipart/form-data',
                    'onsubmit': 'return confirm("¿Guardar los cambios?");'
                }
            }) }}

            <div class="form-group">
                {{ form_label(form.name, 'Nombre del artista') }}
                {{ form_widget(form.name, {'attr': {'class': 'input'}}) }}
            </div>

            <div class="form-group">
                {{ form_label(form.bio, 'Biografía') }}
                {{ form_widget(form.bio, {'attr': {'class': 'textarea'}}) }}
            </div>

            <div class="form-group">
                {{ form_label(form.image, 'Imagen') }}
                {{ form_widget(form.image, {'attr': {'onchange': 'previewImage(event)'}}) }}
            </div>

            <div id="preview-container">
                {% if artist.image %}
                    <img id="preview-image" src="{{ asset('images/artists/' ~ artist.image) }}" alt="Vista previa" />
                {% else %}
                    <img id="preview-image" src="#" alt="Vista previa" style="display: none;" />
                {% endif %}
            </div>

            <div class="form-actions">
                <button class="btn save-btn">Guardar</button>
                <a href="{{ path('app_artista_show', {'id': artist.id}) }}" class="btn back-btn">← Volver</a>
            </div>

            {{ form_end(form) }}
        </div>
    </section>
{% endblock %}

{% block javascripts %}
    <script src="{{ asset('js/previewImage.js') }}"></script>
{% endblock %}
