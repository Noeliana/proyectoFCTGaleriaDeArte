{% extends 'base.html.twig' %}

{% block title %}Registro{% endblock %}

{% block body %}
    <div class="register-wrapper">
        <div class="register-card">
            <div class="login-header">
                <img src="{{ asset('images/logoDisney.png') }}" alt="Logo Galería" />
            </div>
            <h2>Registro</h2>

            {% if registrationForm.vars.errors|length > 0 %}
                <div class="error-message">
                    {{ form_errors(registrationForm) }}
                </div>
            {% endif %}

            {{ form_start(registrationForm, {'attr': {'class': 'register-form'}}) }}

            <label for="{{ registrationForm.email.vars.id }}">Email</label>
            <input type="email" name="{{ registrationForm.email.vars.full_name }}" id="{{ registrationForm.email.vars.id }}"
                   placeholder="Introduce tu email" value="{{ registrationForm.email.vars.value }}" required />
            {{ form_errors(registrationForm.email) }}

            <label for="{{ registrationForm.plainPassword.vars.id }}">Contraseña</label>
            {{ form_widget(registrationForm.plainPassword, {'attr': {'placeholder': 'Crea una contraseña'}}) }}
            {{ form_errors(registrationForm.plainPassword) }}

            <div class="terms">
                {{ form_widget(registrationForm.agreeTerms) }}
                <label for="{{ registrationForm.agreeTerms.vars.id }}">Acepto los <a href="#">términos y condiciones</a></label>
            </div>
            {{ form_errors(registrationForm.agreeTerms) }}

            {{ form_row(registrationForm._token) }}

            <button type="submit">Registrarse</button>

            {{ form_end(registrationForm, { 'render_rest': false }) }}


            <p class="link">¿Ya tienes cuenta? <a href="{{ path('app_login') }}">Inicia sesión</a></p>
        </div>
    </div>
{% endblock %}
