{% extends 'base.html.twig' %}

{% block title %}{{ category.name }} - Imágenes{% endblock %}

{% block body %}
    <section class="categoria">
        <h2>{{ category.name }}</h2>

        {% if images is empty %}
            <p>No hay imágenes para esta categoría todavía.</p>
        {% else %}
            <div class="galeria-imagenes">
                {% for image in images %}
                    <div class="imagen-item">
                        <a href="{{ path('app_image_show', {
                            'id': image.id,
                            'from': 'category',
                            'slug': category.slug
                        }) }}">

                        <img src="{{ asset('images/obras/' ~ image.imageFile) }}" alt="{{ image.title }}">
                        </a>
                        <p>{{ image.title }}</p>
                    </div>
                {% endfor %}
            </div>
        {% endif %}
    </section>
{% endblock %}
