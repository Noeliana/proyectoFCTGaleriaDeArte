{% extends 'base.html.twig' %}

{% block title %}{{ artist.name }} - Perfil{% endblock %}

{% block body %}
    <section class="perfil-artista">
        <h2>{{ artist.name }}</h2>
        <div class="perfil-contenido">
            <img src="{{ asset('images/artists/' ~ artist.image) }}" alt="{{ artist.name }}">
            <p><strong>Biografía:</strong> {{ artist.bio }}</p>
        </div>
        {% if artist.images is not empty %}
            <h3>Obras de {{ artist.name }}</h3>
            <div class="galeria-obras">
                {% for image in artist.images %}
                    <div class="imagen-contenedor" style="position: relative; display: inline-block;">
                        {% if is_granted('ROLE_ADMIN') %}
                            <form method="post"
                                  action="{{ path('app_image_delete', {'id': image.id}) }}"
                                  onsubmit="return confirm('¿Seguro que quieres eliminar esta imagen?');"
                                  style="position: absolute; top: 5px; right: 5px;">
                                <input type="hidden" name="_token" value="{{ csrf_token('delete' ~ image.id) }}">
                                <input type="hidden" name="from" value="artist">
                                <button type="submit"
                                        style="background: white; border: none; border-radius: 50%; width: 25px; height: 25px;
                                   color: red; font-weight: bold; line-height: 1; text-align: center; padding: 0;
                                   box-shadow: 0 0 2px rgba(0,0,0,0.2); cursor: pointer;">
                                    &minus;
                                </button>
                            </form>
                        {% endif %}
                        <a href="{{ path('app_image_show', {'id': image.id, 'from': 'artist'}) }}">
                            <img src="{{ asset('images/obras/' ~ image.imageFile) }}" alt="Imagen de {{ artist.name }}">
                        </a>
                    </div>
                {% endfor %}
            </div>
        {% else %}
            <p>Este artista aún no ha subido ninguna imagen.</p>
        {% endif %}
    </section>
    {% if is_granted('ROLE_ADMIN') %}
        <div class="admin-buttons">
            <a href="{{ path('app_artista_edit', {'id': artist.id}) }}" class="btn-admin-action btn-edit">
                ✏️ Editar artista
            </a>
            <form method="post" action="{{ path('app_artista_delete', {'id': artist.id}) }}"
                  onsubmit="return confirm('¿Estás seguro de que quieres eliminar este artista?');"
                  style="display:inline-block;">
                <input type="hidden" name="_token" value="{{ csrf_token('delete' ~ artist.id) }}">
                <button class="btn-admin-action btn-delete">🗑️ Eliminar artista</button>
            </form>
        </div>
    {% endif %}

{% endblock %}
