{% extends 'base.html.twig' %}

{% block title %}{{ category.name }} - Imágenes{% endblock %}

{% block body %}
    <section class="categoria">
        <h2>{{ category.name }}</h2>

        {% if images is empty %}
            <p>No hay imágenes para esta categoría todavía.</p>
        {% else %}
            <div class="galeria-imagenes">
                {% for image in images %}
                    <div class="imagen-item">
                        <a href="{{ path('app_image_show', {
                            'id': image.id,
                            'from': 'category',
                            'slug': category.slug
                        }) }}">
                            <img src="{{ asset('images/obras/' ~ image.imageFile) }}" alt="{{ image.title }}">
                        </a>
                        <p>{{ image.title }}</p>

                        {% if is_granted('ROLE_USER') or is_granted('ROLE_ADMIN') %}
                            {% if image.owner == app.user %}
                                <div class="acciones-imagen">
                                    <a href="{{ path('app_image_edit', {id: image.id}) }}" class="btn">Editar</a>
                                    <form method="post" action="{{ path('app_image_delete', {'id': image.id}) }}" onclick="return confirm('¿Seguro que quieres eliminar esta imagen?')">
                                        <input type="hidden" name="_token" value="{{ csrf_token('delete' ~ image.id) }}">
                                        <input type="hidden" name="slug" value="{{ category.slug }}">
                                        <button class="btn">Eliminar</button>
                                    </form>
                                </div>
                            {% endif %}
                        {% endif %}
                    </div>
                {% endfor %}

                {% if is_granted('ROLE_USER') or is_granted('ROLE_ADMIN') %}
                    <div class="card-new-image">
                        <a href="{{ path('app_image_new', {'categoryId': category.id}) }}">
                            <div class="plus-sign">+</div>
                            <p>Add image</p>
                        </a>
                    </div>
                {% endif %}
            </div>
        {% endif %}
    </section>
{% endblock %}
